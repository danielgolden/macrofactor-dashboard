# Clerk Auth — from Stripe Projects: stripe projects add clerk/auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/app

# Supabase — from Stripe Projects: stripe projects add supabase/database
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter — LLM provider for the Chat tab. Create a key at https://openrouter.ai/keys
# The model slug is hardcoded in src/app/api/chat/route.ts (Deepseek V4 Flash Latest).
OPENROUTER_API_KEY=
